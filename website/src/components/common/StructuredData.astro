---
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.fovrinteractive.net/#organization',
      name: 'FoVR Interactive',
      url: 'https://www.fovrinteractive.net/',
      email: 'contact@fovrinteractive.net',
      description:
        'Brisbane-based creative studio making virtual reality, mixed reality and interactive experiences.',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Brisbane',
        addressRegion: 'Queensland',
        addressCountry: 'AU',
      },
      sameAs: [
        'https://www.linkedin.com/company/fovr-interactive/',
        'https://www.facebook.com/fovr.interactive',
        'https://x.com/FovrInteractive',
        'https://www.youtube.com/@fovrinteractive',
      ],
      knowsAbout: [
        'Virtual reality development',
        'Mixed reality development',
        'VR training',
        'XR simulation',
        'Meta Quest development',
        'Unity development',
        'Hand tracking',
        'WebXR',
        'Spatial computing',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.fovrinteractive.net/#website',
      url: 'https://www.fovrinteractive.net/',
      name: 'FoVR Interactive',
      publisher: {
        '@id': 'https://www.fovrinteractive.net/#organization',
      },
      inLanguage: 'en-AU',
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
