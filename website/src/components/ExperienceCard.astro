---
import Image from '@/components/common/Image.astro';
import { Icon } from 'astro-icon/components';
import type { Experience } from '@/utils/experiences';
import { releaseStage, storeLinks } from '@/utils/experiences';
import copy from '@/data/site/experiences.json';
interface Props { project: Experience; }
const { project } = Astro.props;
const isReleased = releaseStage(project) === 'released';
---
<article class="group overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-xl shadow-slate-200/40 dark:border-white/10 dark:bg-slate-900 dark:shadow-black/20">
  <a class="grid min-h-64 place-items-center bg-gradient-to-br from-cyan-50 via-slate-50 to-violet-50 p-6 dark:from-slate-950 dark:via-slate-900 dark:to-violet-950/40" href={`/projects/${project.slug}`} aria-label={project.title}>
    <Image class="h-full max-h-64 w-full object-contain transition duration-500 group-hover:scale-[1.03]" src={project.cover.src} alt={project.cover.alt} width={1280} height={720} loading="lazy" />
  </a>
  <div class="p-6">
    <div class="flex flex-wrap gap-2 text-xs font-black uppercase tracking-[0.08em]">
      {project.category && <span class="rounded-full bg-cyan-100 px-3 py-1 text-cyan-800 dark:bg-cyan-400/10 dark:text-cyan-200">{project.category}</span>}
      {project.status && <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-700 dark:bg-white/10 dark:text-slate-300">{project.status}</span>}
    </div>
    <h3 class="mt-4 text-2xl font-black tracking-tight text-slate-950 dark:text-white"><a href={`/projects/${project.slug}`}>{project.title}</a></h3>
    {project.tagline && <p class="mt-2 font-bold text-slate-800 dark:text-slate-200">{project.tagline}</p>}
    <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{project.excerpt}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="rounded-full bg-slate-950 px-4 py-2.5 text-sm font-black text-white dark:bg-white dark:text-slate-950" href={`/projects/${project.slug}`}>{copy.text.view_project}</a>
      {isReleased && storeLinks(project).map((link) => (
        <a class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 px-4 py-2.5 text-sm font-black text-slate-900 dark:border-white/15 dark:text-white" href={link.href} target="_blank" rel="noreferrer">
          {link.icon && <Icon name={link.icon} class="h-4 w-4" aria-hidden="true" />}{link.label}
        </a>
      ))}
    </div>
  </div>
</article>
