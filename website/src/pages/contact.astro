---
import Layout from '@/layouts/PageLayout.astro';
import ContactUs from '@/components/widgets/Contact.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Contact FoVR Interactive | Discuss an XR Project',
  description:
    'Contact FoVR Interactive in Brisbane about VR training, Meta Quest development, mixed reality, XR prototypes, immersive products or technical consulting.',
};

const contactReasons = [
  {
    title: 'XR application development',
    description: 'You need a virtual reality, mixed reality or spatial application designed and developed for a clear use case.',
    icon: 'tabler:device-vision-pro',
  },
  {
    title: 'Training & simulation',
    description: 'You are exploring equipment training, guided procedures, familiarisation or another hands-on learning workflow.',
    icon: 'tabler:school',
  },
  {
    title: 'Prototype or technical discovery',
    description: 'You need to validate an immersive idea, platform choice or interaction before committing to a larger build.',
    icon: 'tabler:flask',
  },
];

const directLinks = [
  {
    label: 'Email',
    value: 'contact@fovrinteractive.net',
    href: 'mailto:contact@fovrinteractive.net',
    icon: 'tabler:mail',
  },
  {
    label: 'Location',
    value: 'Brisbane, Queensland, Australia',
    href: '#contact',
    icon: 'tabler:map-pin',
  },
  {
    label: 'LinkedIn',
    value: 'FoVR Interactive',
    href: 'https://www.linkedin.com/company/fovr-interactive/',
    icon: 'tabler:brand-linkedin',
  },
];
---

<Layout metadata={metadata}>
  <section class="relative isolate overflow-hidden bg-slate-950 px-4 py-20 text-white sm:px-6 lg:py-28">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(34,211,238,0.18),transparent_32rem),radial-gradient(circle_at_84%_12%,rgba(168,85,247,0.16),transparent_34rem)]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-300">Contact FoVR Interactive</p>
        <h1 class="mt-5 max-w-5xl text-5xl font-black tracking-tight sm:text-6xl lg:text-7xl">
          Tell us what people need to learn, understand, experience or do.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 sm:text-xl">
          FoVR Interactive is a Brisbane-based XR development studio. If you are considering virtual reality, mixed reality, immersive training or an XR proof of concept, start with the problem and the intended users. We can help work out the right technical and interaction approach from there.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-full bg-cyan-300 px-5 py-3 font-black text-slate-950 transition hover:-translate-y-0.5" href="#contact">Send a project enquiry</a>
          <a class="rounded-full border border-white/20 bg-white/5 px-5 py-3 font-black text-white transition hover:-translate-y-0.5" href="mailto:contact@fovrinteractive.net">Email directly</a>
        </div>
      </div>

      <div class="rounded-[2rem] border border-white/10 bg-white/5 p-5 backdrop-blur">
        <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-300">Good fit for</p>
        <div class="mt-4 grid gap-4">
          {contactReasons.map((item) => (
            <article class="flex gap-4 rounded-2xl border border-white/10 bg-white/5 p-5">
              <div class="inline-flex h-11 w-11 flex-none items-center justify-center rounded-2xl bg-cyan-300/10 text-cyan-300">
                <Icon name={item.icon} class="h-5 w-5" />
              </div>
              <div>
                <h2 class="text-lg font-black text-white">{item.title}</h2>
                <p class="mt-2 leading-6 text-slate-300">{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">Project enquiry</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">Share enough context for a useful first conversation.</h2>
        <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Useful details include the problem you are trying to solve, who will use the experience, the likely environment or hardware, any existing content or 3D assets, and whether you are looking for discovery, a prototype or a production build.
        </p>
      </div>

      <div class="mt-10 overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-1 shadow-xl shadow-slate-200/40 dark:border-white/10 dark:bg-slate-900 dark:shadow-black/20">
        <ContactUs
          id="contact"
          title="Discuss an XR project"
          subtitle="Share a few details about your goals and FoVR will respond with the most useful next step."
          description="Based in Brisbane, Queensland and available for suitable XR projects across Australia and internationally."
          successTitle="Thanks for reaching out!"
          successBody="Your message has been received. FoVR will reply as soon as possible."
        />
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-4 py-16 dark:bg-slate-950/50 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">Direct contact</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">Prefer another way to reach FoVR?</h2>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {directLinks.map((item) => (
          <a
            class="flex items-center gap-4 rounded-3xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-cyan-300 dark:border-white/10 dark:bg-slate-900"
            href={item.href}
            target={item.href.startsWith('http') ? '_blank' : undefined}
            rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
          >
            <div class="inline-flex h-11 w-11 flex-none items-center justify-center rounded-2xl bg-cyan-100 text-cyan-700 dark:bg-cyan-400/10 dark:text-cyan-300">
              <Icon name={item.icon} class="h-5 w-5" />
            </div>
            <div>
              <span class="block text-xs font-black uppercase tracking-[0.12em] text-cyan-700 dark:text-cyan-300">{item.label}</span>
              <strong class="mt-1 block text-slate-950 dark:text-white">{item.value}</strong>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
