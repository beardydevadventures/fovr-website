---
import copy from '@/data/site/contact.json';
import Layout from '@/layouts/PageLayout.astro';
import ContactUs from '@/components/widgets/Contact.astro';
import { getCollection } from 'astro:content';

const metadata = copy.metadata;
const projects = (await getCollection('projects'))
  .map(({ slug, data }) => ({ slug, title: data.title }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Layout metadata={metadata}>
  <section class="bg-cyan-50 px-4 py-10 text-slate-950 dark:bg-slate-950 dark:text-white sm:px-6 sm:py-14">
    <div class="mx-auto max-w-4xl">
      <h1 class="text-4xl font-black tracking-tight sm:text-5xl">{copy.text.heading}</h1>
      <p class="mt-4 max-w-xl leading-7 text-slate-600 dark:text-slate-300">{copy.text.intro}</p>
    </div>
  </section>
  <ContactUs projects={projects} id="contact" title={copy.text.form_title} successTitle={copy.text.form_successTitle} successBody={copy.text.form_successBody} classes={{ container: '!max-w-4xl !py-8' }} />
  <p class="mx-auto max-w-4xl px-4 pb-12 text-slate-600 dark:text-slate-300 sm:px-6">
    {copy.text.email_label} <a class="font-semibold underline" href="mailto:contact@fovrinteractive.net">contact@fovrinteractive.net</a>
  </p>
</Layout>
