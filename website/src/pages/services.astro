---
import copy from '@/data/site/legacy-services.json';
import Layout from '@/layouts/PageLayout.astro';
const metadata = copy.metadata;
---
<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:py-28">
    <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">{copy.text.fovr_interactive}</p>
    <h1 class="mt-5 text-5xl font-black tracking-tight sm:text-6xl">{copy.text.we_make_experiences}</h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-300">{copy.text.fovr_is_a_creative_studio_making}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="rounded-full bg-cyan-300 px-5 py-3 font-black text-slate-950" href="/projects">{copy.text.explore_our_experiences}</a>
      <a class="rounded-full border border-slate-300 px-5 py-3 font-black dark:border-white/20" href="/contact">{copy.text.contact_support}</a>
    </div>
  </section>
</Layout>
