---
import copy from '@/data/site/home.json';
import Layout from '@/layouts/PageLayout.astro';
import Image from '@/components/common/Image.astro';
import { getCollection } from 'astro:content';
import ExperienceCard from '@/components/ExperienceCard.astro';
import { releaseStage } from '@/utils/experiences';

const metadata = copy.metadata;

const projectEntries = await getCollection('projects');
const projects = projectEntries.map(({ slug, data }) => ({ slug, ...data }));
const featured = projects.find((project) => project.slug === copy.featured.slug);
if (!featured) throw new Error(`Unknown homepage featured project: ${copy.featured.slug}`);
const released = copy.released.slugs.map((slug) => {
  const project = projects.find((project) => project.slug === slug);
  if (!project || releaseStage(project) !== 'released') {
    throw new Error(`Homepage play-now project must be released: ${slug}`);
  }
  return project;
});
const reelId = encodeURIComponent(copy.reel.youtubeId);
const reelUrl = `https://www.youtube-nocookie.com/embed/${reelId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${reelId}&playsinline=1&rel=0&disablekb=1&iv_load_policy=3`;

---

<Layout metadata={metadata}>
  <section class="relative isolate flex min-h-[28rem] sm:min-h-[31rem] items-center overflow-hidden bg-slate-950 px-4 py-20 text-white sm:px-6 lg:py-24">
    {copy.reel.enabled && <div class="hero-reel absolute inset-0" aria-hidden="true">
      <iframe
        src={reelUrl}
        title=""
        tabindex="-1"
        allow="autoplay; encrypted-media"
      ></iframe>
    </div>}
    <div class="absolute inset-0 bg-slate-950/65" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(34,211,238,0.25),transparent_32rem),linear-gradient(90deg,rgba(2,6,23,0.82),rgba(2,6,23,0.3))]" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-6xl">
      <div>
        <h1 class="mt-5 max-w-5xl text-5xl font-black tracking-tight sm:text-6xl lg:text-7xl">{copy.text.we_make_experiences}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 sm:text-xl">{copy.text.games_worlds_and_interactions_that_invite}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-full bg-cyan-300 px-5 py-3 font-black text-slate-950 transition hover:-translate-y-0.5" href="/projects">{copy.text.explore_our_experiences}</a>
        </div>

      </div>

    </div>
  </section>

  <style>
    .hero-reel {
      pointer-events: none;
    }

    .hero-reel iframe {
      position: absolute;
      left: 50%;
      top: 50%;
      width: max(100vw, 177.78vh);
      height: max(56.25vw, 100vh);
      border: 0;
      transform: translate(-50%, -50%);
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-reel {
        display: none;
      }
    }
  </style>

  <section id="projects" class="px-4 py-16 sm:px-6 sm:py-16">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-2">
      <a class="overflow-hidden rounded-[2rem] bg-slate-100 dark:bg-slate-900" href={`/projects/${featured.slug}`} aria-label={featured.title}>
        <Image class="aspect-video w-full object-cover" src={featured.cover.src} alt={featured.cover.alt} width={1280} height={720} loading="lazy" />
      </a>
      <div>
        <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">{copy.featured.eyebrow}</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">{featured.title}</h2>

        <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">{featured.excerpt}</p>
        <a class="mt-7 inline-flex rounded-full bg-cyan-300 px-5 py-3 font-black text-slate-950" href={`/projects/${featured.slug}`}>{copy.featured.cta}</a>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-4 py-16 dark:bg-slate-950/50 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-5">
        <div>
          <h2 class="text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">{copy.released.heading}</h2>
        </div>
        <a class="rounded-full bg-slate-950 px-5 py-3 font-black text-white dark:bg-white dark:text-slate-950" href="/projects/#play-now">{copy.released.cta}</a>
      </div>
      <div class="grid gap-6 lg:grid-cols-2">{released.map((project) => <ExperienceCard project={project} />)}</div>
    </div>
  </section>


  <section id="labs" class="px-4 py-10 sm:px-6 sm:py-14">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-5">
      <div>
        <h2 class="text-2xl font-black tracking-tight text-slate-950 dark:text-white">{copy.text.fovr_labs}</h2>
        <p class="mt-2 max-w-xl text-slate-600 dark:text-slate-300">{copy.text.labs_is_our_space_to_experiment}</p>
      </div>
      <a class="font-black text-cyan-700 hover:underline dark:text-cyan-300" href="/projects/#labs">{copy.text.explore_projects_and_labs_}</a>
    </div>
  </section>
</Layout>
