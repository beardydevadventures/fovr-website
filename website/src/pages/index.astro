---
import copy from '@/data/site/home.json';
import Layout from '@/layouts/PageLayout.astro';
import Image from '@/components/common/Image.astro';
import { getCollection } from 'astro:content';
import ExperienceCard from '@/components/ExperienceCard.astro';
import { releaseStage } from '@/utils/experiences';
import { Icon } from 'astro-icon/components';

const metadata = copy.metadata;

const projectEntries = await getCollection('projects');
const projects = projectEntries.map(({ slug, data }) => ({ slug, ...data }));
const featured = projects.find((project) => project.slug === copy.featured.slug);
if (!featured) throw new Error(`Unknown homepage featured project: ${copy.featured.slug}`);
const released = copy.released.slugs.map((slug) => {
  const project = projects.find((project) => project.slug === slug);
  if (!project || releaseStage(project) !== 'released') {
    throw new Error(`Homepage play-now project must be released: ${slug}`);
  }
  return project;
});
const reelId = encodeURIComponent(copy.reel.youtubeId);
const reelUrl = `https://www.youtube-nocookie.com/embed/${reelId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${reelId}&playsinline=1&rel=0&disablekb=1&iv_load_policy=3`;

const experiences = copy.experiences;

const delivery = copy.delivery;
---

<Layout metadata={metadata}>
  <section class="relative isolate flex min-h-[720px] items-center overflow-hidden bg-slate-950 px-4 py-20 text-white sm:px-6 lg:py-28">
    {copy.reel.enabled && <div class="hero-reel absolute inset-0" aria-hidden="true">
      <iframe
        src={reelUrl}
        title=""
        tabindex="-1"
        allow="autoplay; encrypted-media"
      ></iframe>
    </div>}
    <div class="absolute inset-0 bg-slate-950/65" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(34,211,238,0.25),transparent_32rem),linear-gradient(90deg,rgba(2,6,23,0.82),rgba(2,6,23,0.3))]" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-6xl">
      <div>
        <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-300">{copy.text.immersive_experience_studio_brisbane}</p>
        <h1 class="mt-5 max-w-5xl text-5xl font-black tracking-tight sm:text-6xl lg:text-7xl">{copy.text.we_make_experiences}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 sm:text-xl">{copy.text.games_worlds_and_interactions_that_invite}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-full bg-cyan-300 px-5 py-3 font-black text-slate-950 transition hover:-translate-y-0.5" href="/projects">{copy.text.explore_our_experiences}</a>
          <a class="rounded-full border border-white/20 bg-white/5 px-5 py-3 font-black text-white transition hover:-translate-y-0.5" href="#labs">{copy.text.discover_fovr_labs}</a>
        </div>

        <div class="mt-8 flex flex-wrap gap-2 text-sm font-bold text-slate-200">
          {copy.heroTags.map((item) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5">{item}</span>
          ))}
        </div>
      </div>

    </div>
  </section>

  <style>
    .hero-reel {
      pointer-events: none;
    }

    .hero-reel iframe {
      position: absolute;
      left: 50%;
      top: 50%;
      width: max(100vw, 177.78vh);
      height: max(56.25vw, 100vh);
      border: 0;
      transform: translate(-50%, -50%);
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-reel {
        display: none;
      }
    }
  </style>

  <section id="projects" class="px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-2">
      <a class="overflow-hidden rounded-[2rem] bg-slate-100 dark:bg-slate-900" href={`/projects/${featured.slug}`} aria-label={featured.title}>
        <Image class="aspect-video w-full object-cover" src={featured.cover.src} alt={featured.cover.alt} width={1280} height={720} loading="lazy" />
      </a>
      <div>
        <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">{copy.featured.eyebrow}</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">{featured.title}</h2>
        {featured.status && <p class="mt-3 font-bold text-cyan-700 dark:text-cyan-300">{featured.status}</p>}
        {featured.tagline && <p class="mt-5 text-xl font-bold text-slate-800 dark:text-slate-200">{featured.tagline}</p>}
        <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">{featured.excerpt}</p>
        <a class="mt-7 inline-flex rounded-full bg-cyan-300 px-5 py-3 font-black text-slate-950" href={`/projects/${featured.slug}`}>{copy.featured.cta}</a>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-4 py-16 dark:bg-slate-950/50 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-5">
        <div>
          <h2 class="text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">{copy.released.heading}</h2>
          <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">{copy.released.description}</p>
        </div>
        <a class="rounded-full bg-slate-950 px-5 py-3 font-black text-white dark:bg-white dark:text-slate-950" href="/projects">{copy.released.cta}</a>
      </div>
      <div class="grid gap-6 lg:grid-cols-2">{released.map((project) => <ExperienceCard project={project} />)}</div>
    </div>
  </section>


  <section class="px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
        <div>
          <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">{copy.text.what_we_create}</p>
          <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">{copy.text.made_to_be_experienced}</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">{copy.text.we_bring_together_realtime_3d_interaction}</p>
          <a class="mt-7 inline-flex font-black text-cyan-700 hover:underline dark:text-cyan-300" href="/about">{copy.text.meet_the_studio_}</a>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          {experiences.map((experience) => (
            <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/40 dark:border-white/10 dark:bg-slate-900 dark:shadow-black/20">
              <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-cyan-100 text-cyan-700 dark:bg-cyan-400/10 dark:text-cyan-300">
                <Icon name={experience.icon} class="h-5 w-5" />
              </div>
              <h3 class="mt-4 text-xl font-black tracking-tight text-slate-950 dark:text-white">{experience.title}</h3>
              <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{experience.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>



  <section class="px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">{copy.text.how_fovr_works}</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">{copy.text.from_an_idea_to_a_world}</h2>
        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">{copy.text.we_explore_an_idea_try_it}</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {delivery.map((item, index) => (
          <article class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-slate-900">
            <span class="text-sm font-black text-cyan-700 dark:text-cyan-300">0{index + 1}</span>
            <h3 class="mt-3 text-xl font-black text-slate-950 dark:text-white">{item.title}</h3>
            <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="labs" class="bg-slate-50 px-4 py-16 dark:bg-slate-950/50 sm:px-6 sm:py-24">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">{copy.text.fovr_labs}</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">{copy.text.research_and_prototyping_for_what_comes}</h2>
        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">{copy.text.labs_is_our_space_to_experiment}</p>
        <a class="mt-7 inline-flex font-black text-cyan-700 hover:underline dark:text-cyan-300" href="/projects">{copy.text.explore_projects_and_labs_}</a>
      </div>
      <div class="flex flex-wrap gap-3 rounded-[2rem] border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
        {copy.labTags.map((item) => (
          <span class="rounded-full border border-cyan-200 bg-cyan-50 px-4 py-2 font-bold text-cyan-900 dark:border-cyan-400/20 dark:bg-cyan-400/10 dark:text-cyan-200">{item}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-5xl rounded-[2rem] border border-cyan-200 bg-cyan-50 p-8 text-center text-slate-950 shadow-2xl shadow-slate-200/50 dark:border-white/10 dark:bg-slate-950 dark:text-white dark:shadow-black/20 sm:p-12">
      <p class="text-sm font-black uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">{copy.text.stay_curious}</p>
      <h2 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">{copy.text.have_a_question_about_an_experience}</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">{copy.text.we_welcome_player_feedback_support_questions}</p>
      <div class="mt-8">
        <a class="inline-flex rounded-full bg-cyan-300 px-5 py-3 font-black text-slate-950 transition hover:-translate-y-0.5" href="/contact">{copy.text.get_in_touch}</a>
      </div>
    </div>
  </section>
</Layout>
