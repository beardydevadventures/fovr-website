---
import Layout from '@/layouts/PageLayout.astro';

const metadata = {
  title: 'Diamond Easy Press Kit | FoVR',
  ignoreTitleTemplate: true,
  description: 'Official facts, description, features and press contact information for Diamond Easy by FoVR Interactive.',
  openGraph: { title: 'Diamond Easy Press Kit | FoVR' },
};
---

<Layout metadata={metadata}>
  <article class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:py-20">
    <p class="text-sm font-bold uppercase tracking-widest text-fuchsia-700 dark:text-fuchsia-300">FoVR Interactive</p>
    <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 dark:text-white md:text-5xl">Diamond Easy Press Kit</h1>
    <p class="mt-5 max-w-3xl text-xl leading-8 text-slate-600 dark:text-slate-300">Official information and media resources for Diamond Easy.</p>

    <div class="mt-10 prose prose-lg max-w-none prose-slate dark:prose-invert prose-headings:font-black prose-headings:tracking-tight prose-a:text-fuchsia-700 dark:prose-a:text-fuchsia-300">
      <h2>Quick facts</h2>
      <dl>
        <dt><strong>Developer and publisher</strong></dt><dd>FoVR Interactive</dd>
        <dt><strong>Location</strong></dt><dd>Brisbane, Queensland, Australia</dd>
        <dt><strong>Platform</strong></dt><dd>Meta Quest</dd>
        <dt><strong>Genre</strong></dt><dd>Relaxing creative VR game</dd>
        <dt><strong>Status</strong></dt><dd>In development</dd>
        <dt><strong>Input</strong></dt><dd>Hands or controllers</dd>
      </dl>

      <h2>Short description</h2>
      <p>Diamond Easy is a cosy VR diamond-painting game where players select colours, place sparkling diamonds onto a canvas, and complete artworks at their own pace.</p>

      <h2>Full description</h2>
      <p>Diamond Easy brings the relaxing craft of diamond painting into VR. Pick a colour, place sparkling diamonds and watch your artwork come to life. Choose from quick, approachable designs or larger, detailed artworks, adjust your workspace until it feels comfortable, and create using your hands or controllers.</p>
      <p>No timers. No pressure. Just settle into your cosy space and create at your own pace.</p>

      <h2>Key features</h2>
      <ul>
        <li>Tactile diamond placement designed for VR.</li>
        <li>Quick designs and larger, detailed artworks.</li>
        <li>A comfortable, adjustable creative workspace.</li>
        <li>Support for hands and controllers.</li>
        <li>A relaxed experience without timers or pressure.</li>
      </ul>

      <h2>Assets</h2>
      <div class="rounded-3xl border-2 border-dashed border-slate-300 bg-slate-50 p-8 text-center dark:border-slate-600 dark:bg-slate-900">
        <strong>Press asset pack coming soon</strong>
        <p class="mb-0">Logo files, key art and screenshots will be added here when approved assets are available.</p>
      </div>

      <h2>Approved tagline</h2>
      <p><strong>Pick a colour. Place a diamond. Take it easy.</strong></p>

      <h2>Press contact</h2>
      <p><a href="mailto:contact@fovrinteractive.net">contact@fovrinteractive.net</a></p>

      <h2>Links</h2>
      <ul>
        <li><a href="/projects/diamond-easy">Diamond Easy product page</a></li>
        <li><a href="https://www.meta.com/en-gb/experiences/diamond-easy/1007485185105718/" target="_blank" rel="noreferrer">Meta Quest Store page</a></li>
        <li><a href="https://youtu.be/XP6k4hg4RMU" target="_blank" rel="noreferrer">Diamond Easy official trailer</a></li>
        <li><a href="/projects/diamond-easy/privacy-policy">Diamond Easy Privacy Policy</a></li>
      </ul>
    </div>
  </article>
</Layout>
