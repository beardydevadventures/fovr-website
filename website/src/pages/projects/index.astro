---
import copy from '@/data/site/experiences.json';
import Layout from '@/layouts/PageLayout.astro';
import ExperienceCard from '@/components/ExperienceCard.astro';
import { releaseStage } from '@/utils/experiences';
import { getCollection } from 'astro:content';

const projectEntries = await getCollection('projects');
const projects = projectEntries
  .map(({ slug, data }) => ({ slug, ...data }))
  .sort((a, b) => {
    const orderA = a.order ?? 999;
    const orderB = b.order ?? 999;
    return orderA - orderB || a.title.localeCompare(b.title);
  });

const metadata = copy.metadata;
---

<Layout metadata={metadata}>
  <section class="bg-cyan-50 px-4 py-10 dark:bg-slate-950 sm:px-6 sm:py-14">
    <h1 class="mx-auto max-w-6xl text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">
      {copy.text.heading}
    </h1>
    <nav aria-label="Experience sections" class="mx-auto mt-5 flex max-w-6xl flex-wrap gap-x-5 gap-y-2">
      {copy.groups.filter((group) => projects.some((project) => releaseStage(project) === group.stage)).map((group) => (
        <a class="py-2 font-bold text-cyan-800 underline underline-offset-4 dark:text-cyan-200" href={`#${group.id}`}>{group.title}</a>
      ))}
    </nav>
  </section>

  {copy.groups.map((group) => {
    const entries = projects.filter((project) => releaseStage(project) === group.stage);
    return entries.length > 0 && (
      <section id={group.id} class="scroll-mt-28 px-4 py-10 even:bg-slate-50 dark:even:bg-slate-950/50 sm:px-6 sm:py-16">
        <div class="mx-auto max-w-6xl">
          <div class="mb-10 max-w-3xl">
            <h2 class="text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">{group.title}</h2>
          </div>
          <div class="grid gap-6 lg:grid-cols-2">{entries.map((project) => <ExperienceCard project={project} />)}</div>
        </div>
      </section>
    );
  })}

</Layout>
