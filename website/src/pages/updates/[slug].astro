---
import { Image } from 'astro:assets';
import { getEntry, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/PageLayout.astro';
import { formatUpdateDate, getPublishedUpdates } from '@/utils/updates';

export async function getStaticPaths() {
  return (await getPublishedUpdates()).map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'updates'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const project = data.project ? await getEntry('projects', data.project) : undefined;
const metadata = {
  title: data.title,
  description: data.description,
  openGraph: { type: 'article' as const },
};
---

<Layout metadata={metadata}>
  <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14">
    <a href="/updates/" class="inline-block py-2 font-bold text-cyan-800 underline underline-offset-4 dark:text-cyan-200">
      Back to updates
    </a>
    <header class="mt-5">
      <p class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-600 dark:text-slate-300">
        <time datetime={data.publishDate.toISOString()}>{formatUpdateDate(data.publishDate)}</time>
        {project && <a class="font-bold text-cyan-800 underline underline-offset-4 dark:text-cyan-200" href={`/projects/${project.slug}/`}>{project.data.title}</a>}
      </p>
      <h1 class="mt-2 text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">{data.title}</h1>
      <p class="mt-4 text-lg text-slate-700 dark:text-slate-300">{data.description}</p>
    </header>
    {data.cover && <Image src={data.cover.src} alt={data.cover.alt} class="mt-7 h-auto w-full rounded-2xl" />}
    <div class="prose prose-slate mt-7 max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</Layout>
