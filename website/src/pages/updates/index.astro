---
import { Image } from 'astro:assets';
import Layout from '@/layouts/PageLayout.astro';
import copy from '@/data/site/updates.json';
import { formatUpdateDate, getPublishedUpdates } from '@/utils/updates';

const updates = await getPublishedUpdates();
---

<Layout metadata={copy.metadata}>
  <section class="bg-cyan-50 px-4 py-10 dark:bg-slate-950 sm:px-6 sm:py-14">
    <div class="mx-auto max-w-6xl">
      <h1 class="text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">{copy.heading}</h1>
      <p class="mt-3 text-lg text-slate-700 dark:text-slate-300">{copy.intro}</p>
    </div>
  </section>

  <section class="px-4 py-10 sm:px-6 sm:py-14" aria-label="Studio updates">
    <div class="mx-auto max-w-6xl">
      {updates.length === 0 ? (
        <div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-700 sm:p-8">
          <h2 class="text-xl font-black text-slate-950 dark:text-white">{copy.emptyHeading}</h2>
          <a href="/projects/" class="mt-3 inline-block py-2 font-bold text-cyan-800 underline underline-offset-4 dark:text-cyan-200">
            {copy.emptyAction}
          </a>
        </div>
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {updates.map(({ slug, data }) => (
            <li class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
              <article class="h-full">
                {data.cover && <Image src={data.cover.src} alt={data.cover.alt} widths={[360, 600, 900]} sizes="(min-width: 1024px) 370px, (min-width: 640px) 50vw, 100vw" class="aspect-video w-full object-cover" />}
                <div class="p-5 sm:p-6">
                  <time datetime={data.publishDate.toISOString()} class="text-sm text-slate-600 dark:text-slate-300">
                    {formatUpdateDate(data.publishDate)}
                  </time>
                  <h2 class="mt-2 text-xl font-black text-slate-950 dark:text-white">
                    <a class="underline decoration-transparent underline-offset-4 hover:decoration-current focus-visible:decoration-current" href={`/updates/${slug}/`}>{data.title}</a>
                  </h2>
                  <p class="mt-2 text-slate-700 dark:text-slate-300">{data.description}</p>
                </div>
              </article>
            </li>
          ))}
        </ul>
      )}
      <a class="mt-6 inline-block py-2 text-sm font-bold text-cyan-800 underline underline-offset-4 dark:text-cyan-200" href="/updates/rss.xml">
        {copy.rssLabel}
      </a>
    </div>
  </section>
</Layout>
